# Copier ce fichier en .env et remplir les valeurs

# MongoDB
MONGODB_URI=mongodb://localhost:27017/time-tracker

# Auth locale — secret JWT (générer une chaîne aléatoire longue en prod)
LOCAL_JWT_SECRET=change-me-in-production

# Utilisateurs locaux : format user1:pass1,user2:pass2
LOCAL_USERS=admin:admin

# Azure AD (optionnel en dev — laisser la valeur par défaut tant que l'App Registration n'est pas faite)
AZURE_TENANT_ID=VOTRE_TENANT_ID_ICI
